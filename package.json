  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackple/tubox.git"
  },
  "homepage": "https://tubox.top",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/setup-models.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup:models": "node scripts/setup-models.mjs",
    "og:images": "node scripts/og-images.mjs",
    "marketing:ph": "node scripts/producthunt-assets.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5",
    "@fontsource-variable/geist-mono": "^5",
    "@imgly/background-removal": "1.7.0",
    "@mediapipe/tasks-vision": "^0.10.20",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "framer-motion": "^11.15.0",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "uqr": "^0.1.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
